# Backend only. Never place these secrets in Vercel frontend variables.
NODE_ENV=production
PORT=5000
MONGODB_URI=<YOUR_MONGODB_ATLAS_URI>
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
FRONTEND_ORIGIN=https://<YOUR_VERCEL_DOMAIN>
SITE_URL=https://<YOUR_VERCEL_DOMAIN>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=manavtaagrofood@gmail.com
SMTP_PASS=<GMAIL_16_CHARACTER_APP_PASSWORD>
MAIL_FROM=Manavta Agro Foods <manavtaagrofood@gmail.com>
ADMIN_EMAIL=manavtaagrofood@gmail.com
REQUIRE_LEAD_NOTIFICATIONS=false
